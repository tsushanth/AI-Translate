# Server Configuration
PORT=8080
NODE_ENV=development

# Google Cloud Configuration
# In Cloud Run, this is automatically set from the service account
# For local development, set your project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# For local development only - path to service account key file
# In Cloud Run, authentication is handled automatically via the attached service account
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_TRANSLATION_LOGGING=true
